            "carga",
            "trabalho",
            "puxar",
            "transporte"
          ],
          "answer": "carga",
          "reference": "Mateus 21:5"
        },
        {
          "id": "u4-l1-e2",
          "kind": "trueFalse",
          "prompt": "Verdadeiro ou falso?",
          "statement": "Na entrada triunfal, as pessoas espalharam ramos de palmeiras e mantos no caminho.",
          "isTrue": true,
          "reference": "João 12:13",
          "explanation": "A multidão tomou ramos de palmeiras e saiu ao encontro de Jesus, clamando: Hosana (João 12:13)."
