      "title": "Entrada Triunfal",
      "icon": "music.note",
      "exercises": [
        {
          "id": "u4-l1-e1",
          "kind": "multipleChoice",
          "prompt": "Complete o versículo",
          "text": "\"Dizei à filha de Sião: Eis que o teu Rei vem a ti, manso, montado em jumento e em um jumentinho, cria de animal de ___\".",
