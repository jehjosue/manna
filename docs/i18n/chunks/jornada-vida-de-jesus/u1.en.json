      "icon": "hands.sparkles.fill",
      "exercises": [
        {
          "id": "u1-l4-e1",
          "kind": "multipleChoice",
          "prompt": "Complete the verse",
          "text": "\"When the days of her purification according to the law of Moses were fulfilled, they brought him up to Jerusalem to present him to the Lord.\"",
          "options": [
            "Mary and Jesus",
