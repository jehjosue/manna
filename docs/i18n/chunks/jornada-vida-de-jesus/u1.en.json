          "options": [
            "Herod",
            "Agrippa",
            "Pilate",
            "Cleopatra"
          ],
          "answer": "Herod",
          "reference": "Matthew 2:8"
        },
        {
          "id": "u1-l3-e8",
          "kind": "multipleChoice",
          "prompt": "Where were the magi warned not to return?",
          "text": "The magi were warned in a dream not to return to ___.",
          "options": [
            "Herod",
            "Jerusalem",
            "Bethlehem",
            "the kingdom"
          ],
          "answer": "Herod",
          "reference": "Matthew 2:12"
        }
      ]
    },
    {
      "id": "u1-l4",
