          "distractors": [
            "in the temple",
            "in the city",
            "grace and truth",
            "eternal power"
          ],
          "reference": "Luke 2:14"
        },
        {
          "id": "u1-l3-e4",
          "kind": "multipleChoice",
          "prompt": "What guided the magi to Jesus?",
