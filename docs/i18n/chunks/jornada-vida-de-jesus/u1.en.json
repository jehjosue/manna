            "star",
            "flame",
            "light from heaven",
            "voice of an angel"
          ],
          "answer": "star",
          "reference": "Matthew 2:2"
        },
        {
          "id": "u1-l3-e5",
          "kind": "matchPairs",
          "prompt": "Match the pairs",
          "pairs": [
            {
              "left": "Shepherds",
              "right": "Hear from the angel"
            },
            {
              "left": "Magi",
              "right": "Follow the star"
            },
            {
              "left": "Incense",
              "right": "Gift of the magi"
            },
            {
              "left": "Gold",
              "right": "Gift to the king"
            }
          ],
          "reference": "Luke 2 and Matthew 2"
        },
        {
          "id": "u1-l3-e6",
          "kind": "trueFalse",
          "prompt": "True or false?",
          "statement": "The magi gave Jesus gold, incense, and myrrh.",
          "isTrue": true,
          "reference": "Matthew 2:11",
          "explanation": "Opening their treasures, they offered him gifts: gold, incense, and myrrh (Matthew 2:11)."
        },
        {
          "id": "u1-l3-e7",
          "kind": "multipleChoice",
          "prompt": "Who tried to find Jesus to kill him?",
          "text": "King ___ wanted to find Jesus to destroy him.",
