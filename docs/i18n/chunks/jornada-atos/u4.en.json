  "title": "Unit 4",
  "subtitle": "Paul in Rome and His Letters",
  "guide": {
    "summary": "Paul's letters written during his ministry contain the essence of Christian faith. Romans 8 speaks of hope in Christ, 1 Corinthians 13 exalts love, Philippians 4 teaches joy, Galatians 5 speaks of freedom, Ephesians 6 about the armor of God. These continue to transform lives.",
    "keyVerses": [
      {
        "reference": "Romans 8:28",
        "text": "And we know that in all things God works for good with those who love him."
      },
      {
        "reference": "1 Corinthians 13:4",
        "text": "Love is patient and kind; love is not envious."
      },
      {
        "reference": "Ephesians 6:10",
        "text": "Finally, be strong in the Lord and in the strength of his might."
      }
    ]
  },
  "lessons": [
    {
      "id": "atos-u4-l1",
      "title": "Hope in Christ - Romans 8",
      "icon": "heart.fill",
      "exercises": [
        {
          "id": "atos-u4-l1-e1",
          "kind": "multipleChoice",
          "prompt": "Complete the verse",
          "text": "\"And we know that in all things God works for good with those who love _____.\"",
          "speaker": "Paul",
          "options": [
            "God",
            "Jesus",
            "the law",
            "the Spirit"
          ],
          "answer": "God",
          "reference": "Romans 8:28",
          "explanation": "Paul affirms that God works all circumstances for good for those who love Him."
        },
        {
          "id": "atos-u4-l1-e2",
          "kind": "trueFalse",
          "prompt": "True or false?",
          "statement": "Romans 8:28 means the Christian life will have no difficulties.",
          "isTrue": false,
          "reference": "Romans 8:28",
          "explanation": "The verse does not say there will be no difficulties, but that God works in them for good."
        },
        {
          "id": "atos-u4-l1-e3",
          "kind": "multipleChoice",
          "prompt": "What is the central message of Romans 8?",
          "text": "Paul writes about eternal security in Christ.",
          "options": [
            "Nothing can separate us from God's love in Christ",
            "We must obey the law perfectly",
            "The body is evil and must be rejected",
            "Everyone will be condemned in judgment"
          ],
          "answer": "Nothing can separate us from God's love in Christ",
          "reference": "Romans 8:35-39",
          "explanation": "Romans 8 is a celebration of the security and hope we have in Jesus."
        },
        {
          "id": "atos-u4-l1-e4",
          "kind": "buildVerse",
          "prompt": "Build the verse",
          "text": "Security in Christ in Romans 8:35",
          "tokens": [
            "Who can separate us",
            "from the love of Christ?",
            "Tribulation, or distress",
            "or persecution?"
          ],
          "distractors": [
            "or death",
            "or life",
            "or any creature"
          ],
          "reference": "Romans 8:35"
        },
        {
          "id": "atos-u4-l1-e5",
          "kind": "listen",
          "prompt": "What did you hear?",
          "text": "All things work together for good.",
          "options": [
            "God controls all circumstances",
            "All things work for good",
            "Everything is always easy"
          ],
          "answer": "All things work for good",
          "reference": "Romans 8:28"
        },
        {
          "id": "atos-u4-l1-e6",
          "kind": "matchPairs",
          "prompt": "Match truths from Romans 8",
          "pairs": [
            {
              "left": "Redemption",
              "right": "In Christ Jesus"
            },
            {
              "left": "Hope",
              "right": "Eternal security"
            },
            {
              "left": "Love",
              "right": "Inseparable from Christ"
            },
            {
              "left": "Adoption",
              "right": "Children of God"
            }
          ]
        },
        {
          "id": "atos-u4-l1-e7",
          "kind": "typeAnswer",
          "prompt": "Complete the phrase",
          "text": "\"And we know that in all things God works for good with those who love _____.",
          "answer": "God",
          "reference": "Romans 8:28",
          "options": [
            "God",
            "the Lord"
          ]
        },
        {
          "id": "atos-u4-l1-e8",
          "kind": "trueFalse",
          "prompt": "True or false?",
          "statement": "Nothing can separate us from God's love in Christ.",
          "isTrue": true,
          "reference": "Romans 8:35-39",
          "explanation": "Paul asserts with certainty that nothing can keep us away from Christ's love."
        }
      ]
