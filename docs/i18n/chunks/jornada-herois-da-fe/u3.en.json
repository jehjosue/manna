          "reference": "Ruth 1:4-5",
          "explanation": "Ruth married Elimelech, an Israelite, and after his death, she married Boaz, his relative."
        },
        {
          "id": "herois-u3-l3-e7",
          "kind": "listen",
          "prompt": "What did Ruth do?",
          "text": "Ruth worked in the fields gathering grain.",
          "options": [
            "Gathered grain",
            "Sold cloth",
            "Made bread",
            "Tended sheep"
          ],
          "answer": "Gathered grain",
          "reference": "Ruth 2:3"
        },
        {
          "id": "herois-u3-l3-e8",
          "kind": "speak",
          "prompt": "Read aloud",
          "text": "Your people will be my people and your God my God.",
          "reference": "Ruth 1:16"
        }
      ]
    },
