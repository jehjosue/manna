{
  "id": "herois-u4",
  "title": "Unit 4",
  "subtitle": "Prophets and Faithfulness",
  "guide": {
    "summary": "Elijah, Esther, Daniel, and Jonah demonstrate how God honors faithfulness even in the most extreme situations. Elijah confronted kings; Esther saved her people from genocide; Daniel refused compromise with idolatry; Jonah preached repentance even against his will. Their lives testify that no circumstance is so adverse that faithfulness to God cannot transform it.",
    "keyVerses": [
      {
        "reference": "1 Kings 18:21",
        "text": "Elijah came near to all the people and said, 'How long are you going to hesitate between two opinions? If the Lord is God, follow him. If Baal is god, follow him.'"
      },
      {
        "reference": "Esther 4:16",
        "text": "Go, gather together all the Jews who are present in Susa, and fast for me. Don't eat or drink for three days, night or day. I and my young women will fast the same way. After that I will go in to the king, even though it is against the law; and if I perish, I perish."
      },
      {
        "reference": "Daniel 3:17-18",
        "text": "If it is so, our God whom we serve is able to deliver us from the burning fiery furnace. He will deliver us out of your hand, O king. But even if he doesn't, let it be known to you, O king, that we will not serve your gods or worship the golden image that you have set up."
      }
    ]
  },
  "lessons": [
    {
      "id": "herois-u4-l1",
      "title": "Elijah: The Courageous Prophet",
      "icon": "mountain.2.fill",
      "exercises": [
        {
          "id": "herois-u4-l1-e1",
          "kind": "multipleChoice",
          "prompt": "Which king did Elijah confront?",
          "text": "Elijah confronted king ___.",
          "options": [
            "Ahab",
            "Solomon",
            "David",
            "Jehoshaphat"
          ],
          "answer": "Ahab",
          "reference": "1 Kings 17:1"
        },
        {
          "id": "herois-u4-l1-e2",
          "kind": "typeAnswer",
          "prompt": "Type the missing word",
          "text": "Elijah was fed by ___ in the desert.",
          "answer": "ravens",
          "options": [
            "ravens",
            "angels",
            "people",
            "servants"
          ],
          "reference": "1 Kings 17:4-5"
        },
        {
          "id": "herois-u4-l1-e3",
          "kind": "buildVerse",
          "prompt": "Assemble the verse",
          "text": "Elijah's decisive question",
          "tokens": [
            "If the Lord is God",
            "follow him",
            "if Baal is god",
            "follow him"
          ],
          "distractors": [
            "worship him",
            "believe in him",
            "praise him",
            "fear him"
          ],
          "reference": "1 Kings 18:21"
        },
        {
          "id": "herois-u4-l1-e4",
          "kind": "orderEvents",
          "prompt": "Put the events in order",
          "text": "Sequence of Elijah.",
          "tokens": [
            "Elijah confronts Ahab",
            "Challenges Baal's prophets",
            "Fire comes down",
            "Prophets are destroyed"
          ],
          "reference": "1 Kings 17-18"
        },
        {
          "id": "herois-u4-l1-e5",
          "kind": "matchPairs",
          "prompt": "Match the moments",
          "pairs": [
            {
              "left": "Elijah",
              "right": "Courageous prophet"
            },
            {
              "left": "Ahab",
              "right": "Idolatrous king"
            },
            {
              "left": "Baal",
              "right": "False god"
            },
            {
              "left": "Fire",
              "right": "God's power"
            }
          ],
          "reference": "1 Kings 18"
        },
        {
          "id": "herois-u4-l1-e6",
          "kind": "trueFalse",
          "prompt": "True or false?",
          "statement": "Baal's prophets were able to make fire come down.",
          "isTrue": false,
          "reference": "1 Kings 18:24-29",
          "explanation": "Only Elijah's God answered with fire, proving that He alone was the true God."
        },
        {
          "id": "herois-u4-l1-e7",
          "kind": "listen",
          "prompt": "What did Elijah ask?",
          "text": "Elijah asked the people to choose between God and Baal.",
          "options": [
            "Choose between God",
            "Worship Baal",
            "Follow Ahab",
            "Abandon faith"
          ],
          "answer": "Choose between God",
          "reference": "1 Kings 18:21"
        },
        {
          "id": "herois-u4-l1-e8",
          "kind": "speak",
          "prompt": "Read aloud",
          "text": "There is no God like the God of Israel.",
          "reference": "1 Kings 18:39"
        }
      ]
    },
