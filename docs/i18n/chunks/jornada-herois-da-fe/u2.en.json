{
  "id": "herois-u2",
  "title": "Unit 2",
  "subtitle": "Liberation and Leadership",
  "guide": {
    "summary": "Moses and Joshua led God's people in critical moments. Moses was chosen to free Israel from Egypt through powerful miracles; Joshua conquered the promised land. Both trust in God against impossible odds, revealing that our limitations do not limit God.",
    "keyVerses": [
      {
        "reference": "Exodus 3:10",
        "text": "Come now therefore, and I will send you to Pharaoh, that you may bring my people the children of Israel out of Egypt."
      },
      {
        "reference": "Exodus 14:13-14",
        "text": "Moses said to the people, 'Don't be afraid. Stand still and see the salvation of the Lord, which he will work for you today. For the Egyptians whom you see today, you will never see them again. The Lord will fight for you, and you shall be still.'"
      },
      {
        "reference": "Joshua 6:20",
        "text": "So the people shouted, and the priests blew the trumpets. It happened, when the people heard the sound of the trumpet, that the people shouted with a great shout, and the wall fell down flat."
      }
    ]
  },
  "lessons": [
    {
      "id": "herois-u2-l1",
      "title": "Moses and the Burning Bush",
      "icon": "leaf.fill",
      "exercises": [
        {
          "id": "herois-u2-l1-e1",
          "kind": "multipleChoice",
          "prompt": "What did Moses see in the desert?",
          "text": "Moses saw a ___ that was burning but was not consumed.",
          "options": [
            "bush",
            "tree",
            "forest",
            "flame"
          ],
          "answer": "bush",
          "reference": "Exodus 3:2"
        },
        {
          "id": "herois-u2-l1-e2",
          "kind": "typeAnswer",
          "prompt": "Type the missing word",
          "text": "God chose Moses to ___ Israel from Egypt.",
          "answer": "free",
          "options": [
            "free",
            "save",
            "bring out",
            "deliver"
          ],
          "reference": "Exodus 3:10"
        },
        {
          "id": "herois-u2-l1-e3",
          "kind": "buildVerse",
          "prompt": "Assemble the verse",
          "text": "God's identity",
          "tokens": [
            "I am",
            "the God of Abraham",
            "the God of Isaac",
            "the God of Jacob"
          ],
          "distractors": [
            "of the patriarchs",
            "of Israel",
            "of your fathers",
            "of the Hebrews"
          ],
          "reference": "Exodus 3:6"
        },
        {
          "id": "herois-u2-l1-e4",
          "kind": "orderEvents",
          "prompt": "Put the events in order",
          "text": "Sequence of the calling.",
          "tokens": [
            "Moses sees the bush",
            "God speaks to him",
            "Moses is afraid",
            "God sends him"
          ],
          "reference": "Exodus 3"
        },
        {
          "id": "herois-u2-l1-e5",
          "kind": "matchPairs",
          "prompt": "Match the elements",
          "pairs": [
            {
              "left": "Bush",
              "right": "Divine presence"
            },
            {
              "left": "Moses",
              "right": "Chosen"
            },
            {
              "left": "Egypt",
              "right": "Slavery"
            },
            {
              "left": "Liberation",
              "right": "Miracle"
            }
          ],
          "reference": "Exodus 3-4"
        },
        {
          "id": "herois-u2-l1-e6",
          "kind": "trueFalse",
          "prompt": "True or false?",
          "statement": "Moses accepted God's calling immediately without doubt.",
          "isTrue": false,
          "reference": "Exodus 3:11,4:1",
          "explanation": "Moses questioned God many times, being afraid and insecure, but God encouraged him and equipped him."
        },
        {
          "id": "herois-u2-l1-e7",
          "kind": "listen",
          "prompt": "What did God command?",
          "text": "God commanded Moses to go to Pharaoh.",
          "options": [
            "Go to Pharaoh",
            "Flee Egypt",
            "Build a temple",
            "Prepare sacrifices"
          ],
          "answer": "Go to Pharaoh",
          "reference": "Exodus 3:10"
        },
        {
          "id": "herois-u2-l1-e8",
          "kind": "speak",
          "prompt": "Read aloud",
          "text": "Surely I will be with you, and this shall be a sign to you.",
          "reference": "Exodus 3:12"
        }
      ]
    },
    {
