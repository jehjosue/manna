          "options": [
            "credited",
            "counted",
            "computed",
            "considered"
          ],
          "reference": "Genesis 15:6"
        },
        {
          "id": "herois-u1-l2-e3",
          "kind": "buildVerse",
          "prompt": "Assemble the verse",
          "text": "The promise to Abraham",
          "tokens": [
            "I will make",
            "you into",
            "a great nation"
          ],
          "distractors": [
            "you a people",
            "you a king",
            "you rich",
            "you a ruler"
          ],
          "reference": "Genesis 12:2"
        },
        {
          "id": "herois-u1-l2-e4",
          "kind": "orderEvents",
          "prompt": "Put the events in order",
          "text": "Sequence of Abraham.",
          "tokens": [
            "Called to Canaan",
            "Abraham believes God",
            "Isaac is born",
            "Test of sacrifice"
