          "reference": "Genesis 12-22"
        },
        {
          "id": "herois-u1-l2-e5",
          "kind": "matchPairs",
          "prompt": "Match the characteristics",
          "pairs": [
            {
              "left": "Abraham",
              "right": "Father of faith"
            },
            {
              "left": "Promise",
              "right": "Great nation"
            },
            {
              "left": "Seed",
              "right": "Isaac"
            },
            {
              "left": "Test",
              "right": "Sacrifice"
            }
          ],
          "reference": "Genesis 12-22"
        },
        {
          "id": "herois-u1-l2-e6",
          "kind": "trueFalse",
          "prompt": "True or false?",
          "statement": "Abraham was old when God promised him a son.",
