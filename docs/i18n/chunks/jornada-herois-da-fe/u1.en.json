{
  "id": "herois-u1",
  "title": "Unit 1",
  "subtitle": "The Patriarchs",
  "guide": {
    "summary": "The patriarchs Noah, Abraham, Isaac, Jacob, and Joseph are examples of persevering faith. Despite their fears and weaknesses, they trusted in God's calling. Their lives reveal how God works through generations, fulfilling His promises even when everything seemed impossible.",
    "keyVerses": [
      {
        "reference": "Hebrews 11:8-9",
        "text": "By faith Abraham, when he was called, obeyed by going out to a place which he was to receive for an inheritance; and he went out, not knowing where he was going. By faith he lived as an alien in the land of promise, as in a foreign land."
      },
      {
        "reference": "Genesis 12:1-2",
        "text": "Now the Lord said to Abram, 'Get out of your country, away from your relatives, and away from your father's house, to a land that I will show you. I will make you into a great nation.'"
      },
      {
        "reference": "Genesis 37:28",
        "text": "Then some Midianite traders passed by, so they pulled Joseph up and lifted him out of the pit, and sold him to the Ishmaelites for twenty pieces of silver."
      }
    ]
  },
  "lessons": [
    {
      "id": "herois-u1-l1",
      "title": "Noah and the Ark",
      "icon": "star.fill",
      "exercises": [
        {
          "id": "herois-u1-l1-e1",
          "kind": "multipleChoice",
          "prompt": "What did God ask Noah to build?",
          "text": "God commanded Noah to build an ___.",
          "speaker": "Narrator",
          "options": [
            "ark",
            "house",
            "temple",
            "ship"
          ],
          "answer": "ark",
          "reference": "Genesis 6:14"
        },
        {
          "id": "herois-u1-l1-e2",
          "kind": "typeAnswer",
          "prompt": "Type the missing word",
          "text": "Noah needed to save two of each ___ of living creature.",
          "answer": "kind",
          "options": [
            "kind",
            "type",
            "species",
            "class"
          ],
          "reference": "Genesis 6:19"
        },
        {
          "id": "herois-u1-l1-e3",
          "kind": "buildVerse",
          "prompt": "Assemble the verse",
          "text": "Noah obeyed completely",
          "tokens": [
            "So Noah did",
            "according to all",
            "that God had commanded him"
          ],
          "distractors": [
            "considered",
            "argued",
            "discussed",
            "thought"
          ],
          "reference": "Genesis 6:22"
        },
        {
          "id": "herois-u1-l1-e4",
          "kind": "orderEvents",
          "prompt": "Put the story in order",
          "text": "Sequence of Noah's life.",
          "tokens": [
            "God chooses Noah",
            "Noah builds the ark",
            "Animals enter",
            "Flood destroys the earth"
          ],
          "reference": "Genesis 6-8"
        },
        {
          "id": "herois-u1-l1-e5",
          "kind": "matchPairs",
          "prompt": "Match the elements",
          "pairs": [
            {
              "left": "Noah",
              "right": "Righteous and blameless"
            },
            {
              "left": "Ark",
              "right": "Salvation"
            },
            {
              "left": "Flood",
              "right": "Judgment"
            },
            {
              "left": "Faith",
              "right": "Obedience"
            }
          ],
          "reference": "Genesis 6-9"
        },
        {
          "id": "herois-u1-l1-e6",
          "kind": "trueFalse",
          "prompt": "True or false?",
          "statement": "Noah was the only righteous man in his generation.",
          "isTrue": true,
          "reference": "Genesis 6:9",
          "explanation": "Noah was righteous, blameless, and perfect in his generation, and he walked with God."
        },
        {
          "id": "herois-u1-l1-e7",
          "kind": "listen",
          "prompt": "What did God ask?",
          "text": "Listen: God asked Noah to build an ark.",
          "options": [
            "Build an ark",
            "Leave the land",
            "Preach repentance",
            "Prepare sacrifices"
          ],
          "answer": "Build an ark",
          "reference": "Genesis 6:14"
        },
        {
          "id": "herois-u1-l1-e8",
          "kind": "speak",
          "prompt": "Read aloud",
          "text": "Noah did all that God commanded him.",
          "reference": "Genesis 6:22"
        }
      ]
    },
    {
      "id": "herois-u1-l2",
      "title": "Abraham: The Father of Faith",
      "icon": "book.fill",
      "exercises": [
        {
          "id": "herois-u1-l2-e1",
          "kind": "multipleChoice",
          "prompt": "Where did God call Abraham?",
          "text": "God said to Abraham: 'Leave your land and go to the land I will ___ you.'",
