            "sacerdote",
            "levita",
            "escriba",
            "fariseu"
          ],
          "answer": "sacerdote",
          "reference": "Lucas 10:31"
        },
        {
          "id": "parabolas-u3-l1-e2",
          "kind": "typeAnswer",
          "prompt": "Digite a palavra que falta",
          "text": "O samaritano vendeu sua ___ para pagar pelos cuidados.",
          "answer": "montaria",
