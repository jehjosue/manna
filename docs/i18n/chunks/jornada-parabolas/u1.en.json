{
  "id": "parabolas-u1",
  "title": "Unit 1",
  "subtitle": "The Kingdom of God",
  "guide": {
    "summary": "Jesus taught about the nature of the Kingdom through parables about growth, small beginnings, and great value. The Kingdom starts small as a seed, grows imperceptibly, and is of incalculable value to those who discover it.",
    "keyVerses": [
      {
        "reference": "Matthew 13:31-32",
        "text": "The kingdom of heaven is like a grain of mustard seed, which a man took, and sowed in his field; which indeed is smaller than all seeds. But when it is grown, it is greater than the herbs, and becomes a tree, so that the birds of the sky come and lodge in its branches."
      },
      {
        "reference": "Matthew 13:44",
        "text": "Again, the kingdom of heaven is like a treasure hidden in the field, which a man found, and hid. In his joy, he goes and sells all that he has, and buys that field."
      },
      {
        "reference": "Matthew 13:45-46",
        "text": "Again, the kingdom of heaven is like a merchant seeking fine pearls; and having found one pearl of great value, he went and sold all that he had, and bought it."
      }
    ]
  },
  "lessons": [
    {
      "id": "parabolas-u1-l1",
      "title": "The Sower",
      "icon": "star.fill",
      "exercises": [
        {
          "id": "parabolas-u1-l1-e1",
          "kind": "multipleChoice",
          "prompt": "What is the seed in the Parable of the Sower?",
          "text": "In the Parable of the Sower, the seed represents the ___ of God.",
          "speaker": "Jesus",
          "options": [
            "Word",
            "will",
            "creation",
            "action"
          ],
          "answer": "Word",
          "reference": "Matthew 13:19",
          "explanation": "The seed in the parable represents the Word of the Kingdom, which the sower plants in hearts."
        },
        {
          "id": "parabolas-u1-l1-e2",
          "kind": "typeAnswer",
          "prompt": "Type the missing word",
          "text": "\"The one who sowed the good seed is the ___.\"",
          "answer": "Son",
          "options": [
            "Son",
            "son",
            "Son of Man",
            "Savior"
          ],
          "reference": "Matthew 13:37",
          "explanation": "Jesus explained that the one who sowed the good seed is the Son of Man, referring to himself."
        },
        {
          "id": "parabolas-u1-l1-e3",
          "kind": "buildVerse",
          "prompt": "Build the verse",
          "text": "Different types of soil in the parable",
          "tokens": [
            "Whoever has ears",
            "to hear",
            "let him hear"
          ],
          "distractors": [
            "to understand",
            "read",
            "comprehend",
            "see"
          ],
          "reference": "Matthew 13:9"
        },
        {
          "id": "parabolas-u1-l1-e4",
          "kind": "orderEvents",
          "prompt": "Put the types of soil in order",
          "text": "In the Parable of the Sower, Jesus describes four types of soil where the seed falls.",
          "tokens": [
            "Seed falls on the path",
            "Seed falls on rocky ground",
            "Seed falls among thorns",
            "Seed falls on good soil"
          ],
          "reference": "Matthew 13:4-8"
        },
        {
          "id": "parabolas-u1-l1-e5",
          "kind": "matchPairs",
          "prompt": "Match the types of soil",
          "pairs": [
            {
              "left": "Path",
              "right": "Word is stolen"
            },
            {
              "left": "Rocky ground",
              "right": "Shallow faith"
            },
            {
              "left": "Thorns",
              "right": "Worldly worries"
            },
            {
              "left": "Good soil",
              "right": "Receptive heart"
            }
          ],
          "reference": "Matthew 13:19-23"
        },
        {
          "id": "parabolas-u1-l1-e6",
          "kind": "trueFalse",
          "prompt": "True or false?",
          "statement": "In the Parable of the Sower, every seed that falls produces a great harvest.",
          "isTrue": false,
          "reference": "Matthew 13:4-9",
          "explanation": "Not every seed produces a harvest. Only the seed that falls on good soil produces abundant fruit."
        },
        {
          "id": "parabolas-u1-l1-e7",
          "kind": "listen",
          "prompt": "What did you hear?",
          "text": "Listen to what Jesus said: The seed is the word of God.",
          "options": [
            "The seed is the word of God",
            "The seed is wisdom",
            "The seed is love",
            "The seed is forgiveness"
          ],
          "answer": "The seed is the word of God",
          "reference": "Luke 8:11"
        },
        {
          "id": "parabolas-u1-l1-e8",
          "kind": "speak",
          "prompt": "Read aloud",
          "text": "Whoever has ears to hear, let him hear.",
          "reference": "Matthew 13:9"
        }
      ]
    },
