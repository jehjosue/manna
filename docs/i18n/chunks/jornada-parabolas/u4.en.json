          "options": [
            "excused themselves",
            "refused",
            "departed",
            "withdrew"
          ],
          "reference": "Matthew 22:5"
        },
        {
          "id": "parabolas-u4-l2-e3",
          "kind": "buildVerse",
          "prompt": "Build the verse",
          "text": "The king's call to the poor",
          "tokens": [
            "Go out into",
            "the poor",
            "the lame"
          ],
          "distractors": [
            "the rich",
            "the healthy",
            "the learned",
            "the noble"
          ],
          "reference": "Matthew 22:8-9"
        },
        {
          "id": "parabolas-u4-l2-e4",
          "kind": "orderEvents",
          "prompt": "Put the invitations in order",
          "text": "Sequence of the Great Feast.",
          "tokens": [
            "King invites the notable",
            "All refuse",
            "Invites the poor",
            "House becomes full"
          ],
          "reference": "Matthew 22:1-14"
        },
        {
          "id": "parabolas-u4-l2-e5",
          "kind": "matchPairs",
          "prompt": "Match the reactions",
          "pairs": [
            {
              "left": "First invited",
              "right": "Refuse"
            },
            {
              "left": "Poor and lame",
              "right": "Accept"
            },
            {
              "left": "House full",
              "right": "Fulfillment"
            },
            {
              "left": "Feast",
              "right": "Kingdom offered"
            }
          ],
          "reference": "Matthew 22:1-14"
        },
        {
          "id": "parabolas-u4-l2-e6",
          "kind": "trueFalse",
          "prompt": "True or false?",
          "statement": "All people invited to the feast were welcomed.",
          "isTrue": false,
          "reference": "Matthew 22:11-14",
          "explanation": "A man without wedding clothes was cast out, for he did not prepare himself adequately for the kingdom."
        },
        {
          "id": "parabolas-u4-l2-e7",
          "kind": "listen",
          "prompt": "Who was invited next?",
          "text": "The poor and needy were invited.",
          "options": [
            "Poor and needy",
            "Rich and powerful",
            "Scribes and Pharisees",
            "Priests and Levites"
          ],
          "answer": "Poor and needy",
          "reference": "Matthew 22:9"
        },
        {
          "id": "parabolas-u4-l2-e8",
          "kind": "speak",
          "prompt": "Read aloud",
          "text": "Many are called, but few are chosen.",
          "reference": "Matthew 22:14"
        }
      ]
    },
    {
