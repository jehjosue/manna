{
  "id": "parabolas-u4",
  "title": "Unit 4",
  "subtitle": "Watchfulness and the End",
  "guide": {
    "summary": "Jesus warned his disciples to remain watchful and prepared for his return. Through parables, he taught that the Kingdom will be completed at the end of time, that there is final separation between righteous and unrighteous, and that faithfulness in the face of uncertain timing is supreme virtue.",
    "keyVerses": [
      {
        "reference": "Matthew 25:1-13",
        "text": "Then the kingdom of heaven will be like ten virgins who took their lamps and went out to meet the bridegroom. Five of them were foolish and five were wise."
      },
      {
        "reference": "Matthew 13:24-30",
        "text": "The kingdom of heaven is like a man who sowed good seed in his field, but while people were sleeping, his enemy came and sowed weeds among the wheat, and went away."
      },
      {
        "reference": "Matthew 13:47-50",
        "text": "The kingdom of heaven is like a net that was let down into the lake and caught all kinds of fish. When it was full, the fishermen pulled it up on the shore. Then they sat down and collected the good fish in baskets, but threw the bad away."
      }
    ]
  },
  "lessons": [
    {
      "id": "parabolas-u4-l1",
      "title": "The Ten Virgins",
      "icon": "tent.fill",
      "exercises": [
        {
          "id": "parabolas-u4-l1-e1",
          "kind": "multipleChoice",
          "prompt": "How many virgins were wise?",
          "text": "Of the ten virgins, ___ were wise.",
          "options": [
            "five",
            "ten",
            "three",
            "seven"
          ],
          "answer": "five",
          "reference": "Matthew 25:2"
        },
        {
          "id": "parabolas-u4-l1-e2",
          "kind": "typeAnswer",
          "prompt": "Type the missing word",
          "text": "The wise virgins carried ___ in their jars.",
          "answer": "oil",
          "options": [
            "oil",
            "water",
            "wine",
            "perfume"
          ],
          "reference": "Matthew 25:4"
        },
        {
          "id": "parabolas-u4-l1-e3",
          "kind": "buildVerse",
          "prompt": "Build the verse",
          "text": "Warning to the foolish virgins",
          "tokens": [
            "I don't know you",
            "watch therefore",
            "do not sleep"
          ],
          "distractors": [
            "rest",
            "sleep",
            "wait",
            "relax"
          ],
          "reference": "Matthew 25:12-13"
        },
        {
          "id": "parabolas-u4-l1-e4",
          "kind": "orderEvents",
          "prompt": "Put the events in order",
          "text": "Sequence of the Parable of the Virgins.",
          "tokens": [
            "Ten virgins wait",
            "Bridegroom delays",
            "They awake at night",
            "Wise enter, foolish stay out"
          ],
          "reference": "Matthew 25:1-12"
        },
        {
          "id": "parabolas-u4-l1-e5",
          "kind": "matchPairs",
          "prompt": "Match the characteristics",
          "pairs": [
            {
              "left": "Wise virgins",
              "right": "Oil prepared"
            },
            {
              "left": "Foolish virgins",
              "right": "No preparation"
            },
            {
              "left": "Bridegroom",
              "right": "Jesus"
            },
            {
              "left": "Wedding feast",
              "right": "Kingdom fulfilled"
            }
          ],
          "reference": "Matthew 25:1-13"
        },
        {
          "id": "parabolas-u4-l1-e6",
          "kind": "trueFalse",
          "prompt": "True or false?",
          "statement": "The foolish virgins asked to borrow oil from the wise ones.",
          "isTrue": true,
          "reference": "Matthew 25:8-9",
          "explanation": "The foolish virgins asked for oil, but the wise answered there was not enough for everyone."
        },
        {
          "id": "parabolas-u4-l1-e7",
          "kind": "listen",
          "prompt": "What did the bridegroom say?",
          "text": "Listen: The bridegroom said he did not know the foolish virgins.",
          "options": [
            "Did not know them",
            "Received them",
            "Forgave them",
            "Blessed them"
          ],
          "answer": "Did not know them",
          "reference": "Matthew 25:12"
        },
        {
          "id": "parabolas-u4-l1-e8",
          "kind": "speak",
          "prompt": "Read aloud",
          "text": "Watch, therefore, for you do not know on what day your Lord will come.",
          "reference": "Matthew 25:13"
        }
      ]
    },
    {
      "id": "parabolas-u4-l2",
      "title": "The Great Feast",
      "icon": "scroll.fill",
      "exercises": [
