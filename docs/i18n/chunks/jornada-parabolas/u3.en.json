            "harvests",
            "crops",
            "barns",
            "storehouses"
          ],
          "answer": "harvests",
          "reference": "Luke 12:17"
        },
        {
          "id": "parabolas-u3-l3-e2",
          "kind": "typeAnswer",
          "prompt": "Type the missing word",
          "text": "The rich man planned to ___ and enjoy his goods.",
          "answer": "retire",
          "options": [
            "retire",
            "withdraw",
            "rest",
            "depart"
          ],
          "reference": "Luke 12:18-19"
        },
        {
          "id": "parabolas-u3-l3-e3",
          "kind": "buildVerse",
          "prompt": "Build the verse",
          "text": "Reflection on greed",
          "tokens": [
            "Life",
            "does not consist",
            "in the abundance",
            "of possessions"
          ],
          "distractors": [
            "in enjoyment",
            "in money",
            "in wealth",
            "in pleasure"
          ],
          "reference": "Luke 12:15"
        },
        {
          "id": "parabolas-u3-l3-e4",
          "kind": "orderEvents",
          "prompt": "Put the story in order",
          "text": "Sequence of the Parable of the Rich Fool.",
          "tokens": [
            "Large harvest is gathered",
            "Rich man plans to build",
            "Prepares to rest",
            "Dies that night"
          ],
          "reference": "Luke 12:16-20"
        },
        {
          "id": "parabolas-u3-l3-e5",
          "kind": "matchPairs",
          "prompt": "Match the meanings",
          "pairs": [
            {
              "left": "Abundant harvest",
              "right": "God's blessing"
            },
            {
              "left": "Greed",
              "right": "Spiritual emptiness"
            },
            {
              "left": "Sudden death",
              "right": "Takes nothing"
            },
            {
              "left": "Generosity",
              "right": "True wealth"
            }
          ],
          "reference": "Luke 12:16-21"
        },
        {
          "id": "parabolas-u3-l3-e6",
          "kind": "trueFalse",
          "prompt": "True or false?",
          "statement": "The rich fool shared his harvest with the needy.",
          "isTrue": false,
          "reference": "Luke 12:18-19",
          "explanation": "He only thought of himself: storing everything and enjoying it for himself, without thinking of God or neighbor."
        },
        {
          "id": "parabolas-u3-l3-e7",
          "kind": "listen",
          "prompt": "What was the rich man's plan?",
          "text": "The rich man plans to rest and enjoy his goods.",
          "options": [
            "Rest and enjoy",
            "Work more",
            "Help the poor",
            "Pray to God"
          ],
          "answer": "Rest and enjoy",
          "reference": "Luke 12:18-19"
        },
        {
          "id": "parabolas-u3-l3-e8",
          "kind": "speak",
          "prompt": "Read aloud",
          "text": "No one can take their riches when they die.",
          "reference": "Luke 12:15-21"
        }
      ]
    },
