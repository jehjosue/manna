          "answer": "The fear of the LORD is beginning of wisdom",
          "reference": "Proverbs 1:7"
        },
        {
          "id": "salmos-u3-l1-e6",
          "kind": "matchPairs",
          "prompt": "Match the concepts of wisdom",
          "pairs": [
            {
              "left": "Fear of God",
              "right": "Reverent respect"
            },
            {
              "left": "Wisdom",
              "right": "Discerning understanding"
            },
            {
              "left": "Knowledge",
              "right": "Learning from God"
            },
            {
              "left": "Intelligence",
              "right": "Ability to think"
            }
          ]
        },
        {
          "id": "salmos-u3-l1-e7",
          "kind": "typeAnswer",
          "prompt": "Complete the phrase",
          "text": "\"The fear of the LORD is the beginning of _____.\"",
          "answer": "wisdom",
          "reference": "Proverbs 1:7",
          "options": [
            "wisdom",
            "truth"
          ]
        },
        {
          "id": "salmos-u3-l1-e8",
          "kind": "trueFalse",
          "prompt": "True or false?",
