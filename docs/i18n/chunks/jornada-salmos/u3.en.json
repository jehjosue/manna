  "guide": {
    "summary": "Proverbs teach us practical wisdom for living well. They speak of genuine friendship, honest work, words that heal, and humility. Wisdom fears the LORD and guides us in all decisions.",
    "keyVerses": [
      {
        "reference": "Proverbs 1:7",
        "text": "The fear of the LORD is the beginning of wisdom."
      },
      {
        "reference": "Proverbs 17:17",
        "text": "A friend loves at all times, and a brother is born for adversity."
      },
      {
        "reference": "Proverbs 22:6",
        "text": "Train up a child in the way he should go."
      }
    ]
  },
  "lessons": [
    {
      "id": "salmos-u3-l1",
      "title": "Wisdom and Fear of God",
      "icon": "lightbulb.fill",
      "exercises": [
        {
          "id": "salmos-u3-l1-e1",
          "kind": "multipleChoice",
          "prompt": "Complete the verse",
          "text": "\"The fear of the LORD is the beginning of _____.\"",
          "speaker": "Wisdom",
          "options": [
            "wisdom",
            "truth",
            "virtue",
            "knowledge"
          ],
          "answer": "wisdom",
          "reference": "Proverbs 1:7",
          "explanation": "True wisdom begins with respect and reverence for God."
        },
        {
          "id": "salmos-u3-l1-e2",
          "kind": "trueFalse",
          "prompt": "True or false?",
          "statement": "Wisdom comes mainly from learning with others.",
          "isTrue": false,
          "reference": "Proverbs 1:7",
          "explanation": "Although we learn from others, true wisdom is rooted in the fear of the LORD."
        },
        {
          "id": "salmos-u3-l1-e3",
          "kind": "multipleChoice",
          "prompt": "What does 'fear of the LORD' mean?",
          "text": "This concept does not mean to be afraid as if fleeing, but something different.",
