{
  "id": "salmos-u1",
  "title": "Unidade 1",
  "subtitle": "Confiança em Deus",
  "guide": {
    "summary": "Os Salmos de confiança nos ensinam que, não importa as dificuldades, podemos sempre confiar no cuidado de Deus. Ele é nosso protetor, refúgio e força nos momentos de medo.",
    "keyVerses": [
      {
        "reference": "Salmo 23:1",
        "text": "O Senhor é o meu pastor, nada me faltará."
      },
      {
        "reference": "Salmo 27:1",
        "text": "O Senhor é a minha luz e a minha salvação; a quem terei medo?"
      },
      {
        "reference": "Salmo 91:1-2",
        "text": "Aquele que habita no esconderijo do Altíssimo, à sombra do Onipotente descansará."
      }
    ]
  },
