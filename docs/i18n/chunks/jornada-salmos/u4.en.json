          "kind": "listen",
          "prompt": "Which truth did you hear?",
          "text": "There is a time for everything under heaven.",
          "options": [
            "Time is passing and brief",
            "There is a time for everything heaven",
            "There is purpose in each season"
          ],
          "answer": "There is a time for everything heaven",
          "reference": "Ecclesiastes 3:1"
        },
        {
          "id": "salmos-u4-l5-e6",
          "kind": "matchPairs",
          "prompt": "Match the final themes",
          "pairs": [
            {
              "left": "Repentance",
              "right": "Change of heart"
            },
            {
              "left": "Prayer",
              "right": "Communion with God"
            },
            {
              "left": "Knowledge of God",
              "right": "Divine omniscience"
            },
            {
              "left": "Meaning of life",
              "right": "Fear God"
            }
          ]
        },
        {
          "id": "salmos-u4-l5-e7",
          "kind": "orderEvents",
          "prompt": "Order the path of transformation",
          "text": "Journey of spiritual transformation",
          "tokens": [
            "Recognize the sin",
            "Repent sincerely",
            "Confess to God",
            "Live transformed"
          ]
        },
        {
          "id": "salmos-u4-l5-e8",
          "kind": "trueFalse",
          "prompt": "True or false?",
          "statement": "Prayer and repentance are essential parts of a healthy life with God.",
          "isTrue": true,
