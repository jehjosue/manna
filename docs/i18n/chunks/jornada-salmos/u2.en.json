{
  "id": "salmos-u2",
  "title": "Unit 2",
  "subtitle": "Praise and Gratitude",
  "guide": {
    "summary": "The Psalms of praise and gratitude teach us to celebrate God's wonderful works and to be grateful for the blessings received. Gratitude transforms us and brings us closer to God.",
    "keyVerses": [
      {
        "reference": "Psalm 100:1",
        "text": "Make a joyful noise to God, all the earth!"
      },
      {
        "reference": "Psalm 103:1-2",
        "text": "Bless the LORD, my soul; and all that is within me, bless his holy name."
      },
      {
        "reference": "Psalm 150:4",
        "text": "Praise him with tambourine and dance."
      }
    ]
  },
  "lessons": [
    {
      "id": "salmos-u2-l1",
      "title": "The Joy of Praise",
      "icon": "music.note",
      "exercises": [
        {
          "id": "salmos-u2-l1-e1",
          "kind": "multipleChoice",
          "prompt": "Complete the verse",
          "text": "\"Make a joyful noise to God, all the _____.\"",
          "speaker": "Psalmist",
          "options": [
            "earth",
            "nation",
            "multitude",
            "community"
          ],
          "answer": "earth",
          "reference": "Psalm 100:1",
          "explanation": "Praise to God should be universal and involve all of creation in genuine joy."
        },
        {
          "id": "salmos-u2-l1-e2",
          "kind": "trueFalse",
          "prompt": "True or false?",
          "statement": "Psalm 100 is a psalm of praise that exhorts people to praise God with joy.",
          "isTrue": true,
          "reference": "Psalm 100",
          "explanation": "Psalm 100 is entirely dedicated to joyful praise and gratitude to God."
        },
        {
          "id": "salmos-u2-l1-e3",
          "kind": "multipleChoice",
          "prompt": "Why should we praise God according to Psalm 100:5?",
          "text": "\"For the LORD is good; his mercy is _____.\"",
          "options": [
            "everlasting",
            "matchless",
            "sufficient",
            "powerful"
          ],
          "answer": "everlasting",
          "reference": "Psalm 100:5",
          "explanation": "God's goodness and mercy are constant and never end, reason enough for praise."
        },
        {
          "id": "salmos-u2-l1-e4",
          "kind": "buildVerse",
          "prompt": "Build the verse",
          "text": "Call to praise in Psalm 100:1-2",
          "tokens": [
            "Make a joyful noise",
            "to God, all the earth",
            "Serve the LORD",
            "with gladness"
          ],
          "distractors": [
            "with fear",
            "with reverence",
            "with devotion"
          ],
          "reference": "Psalm 100:1-2"
        },
        {
          "id": "salmos-u2-l1-e5",
          "kind": "listen",
          "prompt": "What did you hear?",
          "text": "Serve the LORD with gladness!",
          "options": [
            "Praise the LORD with gladness",
            "Serve the LORD with gladness",
            "Sing to the LORD with power"
          ],
          "answer": "Serve the LORD with gladness",
          "reference": "Psalm 100:2"
        },
        {
          "id": "salmos-u2-l1-e6",
          "kind": "matchPairs",
          "prompt": "Match the elements of praise",
          "pairs": [
            {
              "left": "Joyful noise",
              "right": "Expression of gladness"
            },
            {
              "left": "Serve the LORD",
              "right": "Active worship"
            },
            {
              "left": "Know His goodness",
              "right": "Reason for praise"
            },
            {
              "left": "Enter His courts",
              "right": "Drawing near to God"
            }
          ]
        },
        {
          "id": "salmos-u2-l1-e7",
          "kind": "typeAnswer",
          "prompt": "Complete the phrase",
          "text": "\"For the LORD is good; his mercy is _____.\"",
          "answer": "everlasting",
          "reference": "Psalm 100:5",
          "options": [
            "everlasting",
            "eternal"
          ]
        },
        {
          "id": "salmos-u2-l1-e8",
          "kind": "trueFalse",
          "prompt": "True or false?",
          "statement": "Praising God with gladness is only for the good times of life.",
          "isTrue": false,
          "reference": "Psalm 100",
          "explanation": "Psalm 100 calls us to praise with joy regardless of circumstances, as an act of faith."
        }
      ]
    },
    {
