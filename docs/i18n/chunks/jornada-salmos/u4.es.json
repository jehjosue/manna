    "keyVerses": [
      {
        "reference": "Salmo 51:10",
        "text": "Crea en mí, oh Dios, un corazón limpio, y renueva un espíritu recto dentro de mí."
      },
      {
        "reference": "Salmo 139:1",
        "text": "Señor, tú me sondas y me conoces."
      },
      {
        "reference": "Mateo 6:9-13",
        "text": "Por lo tanto, oren así: Padre nuestro, que estás en los cielos..."
      }
    ]
  },
